generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RedeemCodeStatus {
  ACTIVE
  REDEEMED
  DISABLED
}

enum OwnerAccountStatus {
  ACTIVE
  PAUSED
}

enum InvitationStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model RedeemCode {
  id           String           @id @default(uuid()) @db.Uuid
  codeHash     String           @unique @map("code_hash")
  status       RedeemCodeStatus @default(ACTIVE)
  orderNo      String?          @map("order_no")
  expiresAt    DateTime?        @map("expires_at")
  redeemedAt   DateTime?        @map("redeemed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  invitation   InvitationTask?

  @@map("redeem_codes")
}

model OwnerAccount {
  id            String             @id @default(uuid()) @db.Uuid
  label         String             @unique
  status        OwnerAccountStatus @default(ACTIVE)
  capacityTotal Int                @default(5) @map("capacity_total")
  capacityUsed  Int                @default(0) @map("capacity_used")
  pendingSlots  Int                @default(0) @map("pending_slots")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  invitations   InvitationTask[]

  @@map("owner_accounts")
}

model InvitationTask {
  id                String           @id @default(uuid()) @db.Uuid
  publicId          String           @unique @default(uuid()) @map("public_id") @db.Uuid
  email             String
  maskedEmail       String           @map("masked_email")
  status            InvitationStatus @default(QUEUED)
  failureReason     String?          @map("failure_reason")
  providerReference String?          @map("provider_reference")
  redeemCodeId      String           @unique @map("redeem_code_id") @db.Uuid
  ownerAccountId    String           @map("owner_account_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  completedAt       DateTime?        @map("completed_at")
  redeemCode        RedeemCode       @relation(fields: [redeemCodeId], references: [id])
  ownerAccount      OwnerAccount     @relation(fields: [ownerAccountId], references: [id])

  @@index([status, createdAt])
  @@index([ownerAccountId, status])
  @@map("invitation_tasks")
}
