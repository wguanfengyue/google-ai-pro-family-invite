# Copy to .env for local development. Never commit real credentials.
POSTGRES_DB=family_invite
POSTGRES_USER=family_invite
POSTGRES_PASSWORD=local_only_password
DATABASE_URL=postgresql://family_invite:local_only_password@localhost:5432/family_invite?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
API_PORT=3000
WEB_PORT=8080
CARD_HASH_PEPPER=replace-with-a-long-random-value
ADMIN_API_KEY=replace-with-a-long-random-value
INVITATION_EXECUTOR=mock
# Set to browser only on a trusted machine with a pre-authenticated local profile.
# Never put Google passwords, cookies, tokens, or 2FA secrets in this file.
BROWSER_PROFILE_ROOT=.familyflow/browser-profiles
BROWSER_HEADLESS=true
GOOGLE_FAMILY_INVITE_URL=https://families.google.com/families
BROWSER_ALLOWED_HOSTS=families.google.com
BROWSER_ALLOW_INSECURE=false
VITE_API_BASE_URL=/api
